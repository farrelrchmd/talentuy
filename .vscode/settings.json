{
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/api/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/apps/api"],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/apps/api",
  "python.testing.pytestArgs": ["tests"],
  "css.lint.unknownAtRules": "ignore",
  "eslint.workingDirectories": [
    { "directory": "apps/web", "changeProcessCWD": true }
  ],
  "typescript.tsdk": "apps/web/node_modules/typescript/lib",
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/docs/screenshots": true
  }
}

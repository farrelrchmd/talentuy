# Salin menjadi .env sebelum menjalankan docker compose.
# Berkas .env tidak boleh di-commit. Seluruh credential hanya dibaca server.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=talentpulse
POSTGRES_PASSWORD=talentpulse
POSTGRES_DB=talentpulse
POSTGRES_PORT=5432

# --- Backend ----------------------------------------------------------------
ENVIRONMENT=development
API_PORT=8000
# Ganti dengan nilai acak panjang pada environment non-development.
JWT_SECRET=dev-only-insecure-secret-change-me
# Kunci HMAC penyamaran identitas akun. Ganti dengan nilai acak panjang dan
# jangan diubah setelah ada data, karena hash lama tidak akan cocok lagi.
AUTHOR_HASH_KEY=dev-only-insecure-author-key-change-me
CORS_ORIGINS=http://localhost:3000

# demo  = seluruh angka berasal dari dataset sintetis
# live  = memakai provider X terpilih; hanya aktif bila credential tersedia
DATA_SOURCE_MODE=demo
# Provider: official atau twitterapi_io
X_API_PROVIDER=official
TWITTERAPI_IO_KEY=
X_API_BEARER_TOKEN=

# Password akun demo (admin/analyst/viewer). Hanya untuk development.
DEMO_PASSWORD=TalentPulse123!

# --- Frontend ---------------------------------------------------------------
WEB_PORT=3000
# Dibaca saat build; nilai ini ikut ter-bundle ke browser, jadi jangan diisi
# dengan URL internal yang bersifat rahasia.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

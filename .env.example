# Salin menjadi .env sebelum menjalankan docker compose.
# Berkas .env tidak boleh di-commit. Seluruh credential hanya dibaca server.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=talentpulse
POSTGRES_PASSWORD=talentpulse
POSTGRES_DB=talentpulse
POSTGRES_PORT=5432

# --- Backend ----------------------------------------------------------------
ENVIRONMENT=development
API_PORT=8000
# Ganti dengan nilai acak panjang pada environment non-development.
JWT_SECRET=dev-only-insecure-secret-change-me
CORS_ORIGINS=http://localhost:3000

# demo  = seluruh angka berasal dari dataset sintetis
# live  = memakai connector X API resmi; hanya aktif bila token di bawah terisi
DATA_SOURCE_MODE=demo
X_API_BEARER_TOKEN=

# Password akun demo (admin/analyst/viewer). Hanya untuk development.
DEMO_PASSWORD=TalentPulse123!

# --- Frontend ---------------------------------------------------------------
WEB_PORT=3000
# Dibaca saat build; nilai ini ikut ter-bundle ke browser, jadi jangan diisi
# dengan URL internal yang bersifat rahasia.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
